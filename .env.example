APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
DATABASE_URL=sqlite:///./data/database/finance.db
DATA_ROOT=/app/data
FRONTEND_ORIGIN=http://localhost:3000
# PDF rendering engine: weasyprint (default) or libreoffice
PDF_ENGINE=weasyprint

# Extraction engine (see extraction-engine/config.yaml for the full config).
# Product providers: openrouter (PROD) | ollama (DEV). Default is derived from
# APP_ENV (dev->ollama, prod->openrouter); set this to override explicitly.
EXTRACTION_PROVIDER=openrouter
# Required for the openrouter (cloud) provider:
OPENROUTER_API_KEY=

# --- Authentication (JWT) ---
# Keep AUTH_ENABLED=true for any deployment that is reachable over a network.
AUTH_ENABLED=true
AUTH_USERNAME=admin
# bcrypt hash of the password — generate with: make hash-password
AUTH_PASSWORD_HASH=
# Long random secret for signing tokens — generate e.g. with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRY_HOURS=3
