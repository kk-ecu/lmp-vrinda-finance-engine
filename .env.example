# Copy to .env for LOCAL development. For VPS deployment, deploy.sh generates
# .env.deploy for you — you do not hand-write this on the server.

# Environment: development | production
# Drives the extraction provider policy:
#   development -> default ollama; allowed [ollama, openrouter]
#   production  -> default & only openrouter (others refused by the API)
APP_ENV=development

API_HOST=0.0.0.0
API_PORT=8000

# Where persistent data lives (SQLite + sources + reports). A relative path is
# resolved against the repo root; containers set this to /app/data.
DATA_ROOT=./data

# Browser origin for CORS. Local Vite dev server runs on 5173.
FRONTEND_ORIGIN=http://localhost:5173

# PDF rendering engine: weasyprint (default) or libreoffice
PDF_ENGINE=weasyprint

# --- Extraction engine ---
# Product providers: ollama (DEV) | openrouter (PROD). Leave this unset to use
# the APP_ENV-based default (dev->ollama, prod->openrouter); set to override.
# EXTRACTION_PROVIDER=ollama
# Required only for the openrouter (cloud) provider:
OPENROUTER_API_KEY=

# --- Authentication (JWT) ---
# Keep AUTH_ENABLED=true for anything reachable over a network. (May be false
# for purely local development convenience.)
AUTH_ENABLED=true
AUTH_USERNAME=admin
# bcrypt hash of the password — generate with: make hash-password
AUTH_PASSWORD_HASH=
# Long random secret for signing tokens:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRY_HOURS=3
